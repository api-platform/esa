{
	# https://caddyserver.com/docs/caddyfile/directives#sorting-algorithm
	order mercure after encode
	order vulcain after reverse_proxy
}

localhost 

root /srv
vulcain
file_server

handle /books {
  header "Link" "</books>; rel=\"self\", <https://localhost/.well-known/mercure>; rel=\"mercure\""
  try_files ./tests-server/fixtures/books.jsonld {path}
}

handle /books/* {
  header "Link" "<{path}>; rel=\"self\", <https://localhost/.well-known/mercure>; rel=\"mercure\""
  try_files ./tests-server/fixtures/{path}.jsonld {path}
}

handle /authors/* {
  header "Link" "<{path}>; rel=\"self\", <https://localhost/.well-known/mercure>; rel=\"mercure\""
  try_files ./tests-server/fixtures/{path}.jsonld {path}
}

handle /typed-authors/* {
  header "Link" "<{path}>; rel=\"self\", <https://localhost/.well-known/mercure>; rel=\"mercure\"; last-event-id=\"urn:uuid:5e94c686-2c0b-4f9b-958c-92ccc3bbb4eb\"; type=\"author\"; content-type=\"application/ld+json\""
  try_files ./tests-server/fixtures/{path}.jsonld {path}
}

handle /pattern-authors/* {
  header "Link" "<{path}>; rel=\"self\", <https://localhost/.well-known/mercure>; rel=\"mercure\""
  try_files ./tests-server/fixtures/{path}.jsonld {path}
}

handle /other-authors/* {
  header "Link" "<{path}>; rel=\"self\", <https://localhost:8443/.well-known/mercure>; rel=\"mercure\""
  try_files ./tests-server/fixtures/{path}.jsonld {path}
}

handle /index.js {
  try_files ./*/{path} {path}
}

handle /*.js {
  root /srv/packages
  try_files ./*/{path} {path}
}

handle /* {
  try_files ./tests-server/{path}.html {path}
}

handle / {
  try_files ./tests-server/index.html {path}
}

mercure {
  anonymous

  resource_identifier https://localhost/.well-known/mercure
  issuer https://localhost {
    publisher {
      jwt key HS256
    }
    subscriber {
      jwt key HS256
    }
  }

  debugger
}
